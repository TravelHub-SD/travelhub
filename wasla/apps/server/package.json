{
  "name": "@wasla/server",
  "version": "1.0.0",
  "private": true,
  "description": "سيرفر تطبيق وصله للتوصيل",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma db push --force-reset && node prisma/seed.js",
